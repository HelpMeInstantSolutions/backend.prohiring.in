# Server Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prohiring_user
DB_PASSWORD=your_db_password
DB_NAME=prohiring_db

# JWT Secrets
JWT_SECRET=prohiring_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=10

# Client URLs (CORS)
CLIENT_URL=https://prohiring.in,http://localhost:3000
ADMIN_URL=https://admin.prohiring.in,http://localhost:3001
